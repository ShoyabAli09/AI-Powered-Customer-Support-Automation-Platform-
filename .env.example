# ==============================================================================
# AI-Powered Customer Support Automation Platform - Environment Configuration
# ==============================================================================

# Application & Environment
PROJECT_NAME="AI-Powered Customer Support Automation Platform"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL with pgvector)
# For local Docker Compose: postgresql://postgres:postgres@postgres:5432/support_platform
# For local SQLite fallback: sqlite:///./support_platform.db
DATABASE_URL=sqlite:///./support_platform.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_platform
POSTGRES_PORT=5432

# Redis & Celery Configuration
# For local Docker Compose: redis://redis:6379/0
# For eager test/standalone mode without Redis: CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# OpenAI API Credentials (Optional - platform includes robust semantic fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security & Authentication
# Generate in production via: openssl rand -hex 32
JWT_SECRET=production_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Policy & Escalation Thresholds
AI_CONFIDENCE_THRESHOLD=0.75
AUTO_ESCALATE_ON_LOW_CONFIDENCE=True

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Seed Data Credentials (Created automatically on startup if empty)
# Admin: admin@supportplatform.ai / AdminPass123!
# Agent: agent.sarah@supportplatform.ai / AgentPass123!
# Customer: customer.john@example.com / CustomerPass123!
