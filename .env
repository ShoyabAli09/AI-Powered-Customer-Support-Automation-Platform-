# Application & Environment
PROJECT_NAME="AI-Powered Customer Support Automation Platform"
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=sqlite:///./support_platform.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_platform
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

JWT_SECRET=production_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_CONFIDENCE_THRESHOLD=0.75
AUTO_ESCALATE_ON_LOW_CONFIDENCE=True

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
